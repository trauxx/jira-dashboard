# Credenciais Jira (usadas como padrão pelo servidor — não vão para o client)
JIRA_DOMAIN=traux.atlassian.net
JIRA_EMAIL=seu@email.com
JIRA_API_TOKEN=seu_api_token
JIRA_BOARD_ID=1

# Provedor de IA
# Padrão: proxy Lambda (AWS Bedrock via IAM) — não requer segredo.
# Sobrescreva apenas se quiser usar outro endpoint OpenAI-compatible.
LLM_API_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=120000

# Alternativa: Open WebUI direto (preferir API key; login por senha é fallback).
OWU_BASE_URL=
OWU_API_KEY=
OWU_MODEL=claude-sonnet-4
OWU_EMAIL=
OWU_PASSWORD=

# tickets-apiv2 (autenticação de usuário)
TICKETS_API_URL=https://api.acessofacil.com/v2
# Header Origin enviado para a API resolver a empresa (CompanyMiddleware)
TICKETS_COMPANY_ORIGIN=https://meubilhete.com.br

# Cloudflare Turnstile (captcha no login)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
